#!/bin/bash
# scripts/loopbin/systemd-run - first in PATH inside the autoloop (scripts/autoloop.sh). A loop session opens its own
# memory-capped scopes (`systemd-run --user --scope ...`); without a slice they land in app.slice, beside the maintainer's own
# programs and outside what scripts/loop_cpu.py governs. This adds `--slice=openbf.slice` to such a call and nothing else.
real=/usr/bin/systemd-run
if [ "${OPENBF_LOOP:-}" = 1 ]; then
  user=0; scope=0; slice=0
  for a in "$@"; do
    case "$a" in
      --user) user=1 ;;
      --scope) scope=1 ;;
      --slice|--slice=*) slice=1 ;;
      --) break ;;
    esac
  done
  if [ $user = 1 ] && [ $scope = 1 ] && [ $slice = 0 ]; then
    exec "$real" --slice=openbf.slice "$@"
  fi
fi
exec "$real" "$@"
